
import java.util.Scanner;
 
 
 
 
public class Matrix2 {
    public static void main(String[] args) {
 
        Scanner sc = new Scanner(System.in);
        char answer;
        String option = "";
        do {
            int[][] matrix = new int[3][3];
 
            System.out.println("Input 9 elements:");
 
            for (int r = 0; r < 3; r++) {
                for (int c = 0; c < 3; c++) {
                    matrix[r][c] = sc.nextInt();
                }
            }
 
            System.out.println("\n==============================================");
 
            System.out.printf("%40s%n", "Row Sum"); //Used for formatting 40 margin to the right of the output
 
            int one = 0;  //for first diag
            int two = 0;  // for second diag
 
            for (int r = 0; r < 3; r++) {  
 
                int rowSum = 0;
 
                for (int c = 0; c < 3; c++) {
                    System.out.printf("%8d", matrix[r][c]); //format for the matrix 8 margin to the right of the output
                    rowSum += matrix[r][c];
                }
 
                System.out.printf("%10d%n", rowSum); // also format formula to control spacing
 
                one += matrix[r][r];
                two += matrix[r][2 - r]; //formula for the diagonal sum
            }
 
            //System.out.print("\nColumn sum: ");
            //System.out.printf("%55s%n", "Column Sum"); //format for the column sum 55 margin to the right of the output
            System.out.print("\nColumn sum: ");

            for (int c = 0; c < 3; c++) { // Loop to calculate the sum of each column
 
                int columnSum = 0;
 
                for (int r = 0; r < 3; r++) { // Loop to calculate the sum of each column
                    columnSum += matrix[r][c];
                }
 
                System.out.printf("%8d", columnSum); //same with the formatting for the column sum
            }
 
            System.out.println("\n");
            System.out.println("Diagonal sum 1: " + one);
            System.out.println("Diagonal sum 2: " + two);
            System.out.println("Display Total Elements: " +(matrix.length * matrix[0].length)); // formula to display the total elements of the matrixc it is dyanmic because it will change if the user input a different size of matrix

            System.out.println("==============================================");
 
           System.out.print("\nDo you want to continue? (Y/N): ");
           option = sc.next();
        } while (option.equalsIgnoreCase("Y"));

            


 // Close the scanner

        sc.close();
    }
}


